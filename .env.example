NODE_ENV=development
PORT=3000

# Each service overrides SERVICE_NAME, PORT, MONGO_DATABASE, KAFKA_CLIENT_ID, and KAFKA_GROUP_ID.
# Owned databases: identity-db, catalog-db, inventory-db, order-db, payment-db, notification-db.
# The gateway does not open MongoDB; set MONGO_DATABASE=unused for it.
SERVICE_NAME=api-gateway
# The replica set advertises 127.0.0.1:27017. Use that host, not localhost.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DATABASE=unused

REDIS_URL=redis://127.0.0.1:6379

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=api-gateway
KAFKA_GROUP_ID=api-gateway

JWT_ISSUER=commerce-identity
JWT_AUDIENCE=commerce-api

# Key files are local-only. Never commit PEM material.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Host processes share 127.0.0.1. Compose sets one URL per service DNS name.
# GATEWAY_IDENTITY_URL=http://identity-service:3001
# GATEWAY_CATALOG_URL=http://catalog-service:3002
# GATEWAY_INVENTORY_URL=http://inventory-service:3003
# GATEWAY_ORDER_URL=http://order-service:3004

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

LOG_LEVEL=info
