{
  "name": "commerce-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented event-driven ecommerce platform.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && pnpm --filter @commerce-flow/storefront typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter @commerce-flow/storefront test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.0",
    "@testcontainers/kafka": "12.1.0",
    "@testcontainers/mongodb": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "^24.6.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.6.0",
    "prettier": "^3.9.9",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.3.0",
    "testcontainers": "12.1.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
